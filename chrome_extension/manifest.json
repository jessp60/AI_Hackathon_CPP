{
  "manifest_version": 3,
  "name": "Insight Quest Events",
  "description": "See today's Insight Association events and get same-day reminders.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "action": {
    "default_title": "Insight Quest Events",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon-128.png"
  }
}
